# IDC v0.15 runtime configuration
# Copy this file to .env and fill in your real API key.

GROK_API_KEY=your-grok-api-key-here
GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_MODEL_NAME=grok-4-1-fast-non-reasoning

# Default API provider. Grok remains the default.
# Set to kimi to use Kimi/Moonshot by default, or choose the provider in the GUI/server page.
IDC_API_PROVIDER=grok

# Optional Kimi/Moonshot provider. Kimi is OpenAI-compatible.
# KIMI_API_KEY=your-kimi-api-key-here
# MOONSHOT_API_KEY=your-kimi-api-key-here
# KIMI_API_URL=https://api.moonshot.cn/v1/chat/completions
# KIMI_MODEL_NAME=kimi-k2.5

# Optional desktop/runtime:
# IDC_ENV_FILE=C:\path\to\.env

# Optional OCR server/runtime:
# IDC_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# IDC_OCR_LANG=chi_sim+eng

# Optional intranet web server:
# IDC_SERVER_HOST=0.0.0.0
# IDC_SERVER_PORT=8080
# IDC_SERVER_ACCESS_TOKEN=change-this-token
# IDC_SERVER_MAX_UPLOAD_MB=200
# IDC_SERVER_WORKERS=1
# IDC_SERVER_UPLOAD_DIR=D:\IDC\uploads
# IDC_SERVER_REPORT_DIR=D:\IDC\reports

# v0.17 evidence, code library, persistence, and retention:
# IDC_CODE_LIBRARY=D:\IDC\official-codes
# IDC_CODE_PACK_PATH=D:\IDC\custom-code-packs
# IDC_DATA_DIR=D:\IDC\data
# IDC_RETENTION_DAYS=30
# IDC_SERVER_SECRET_KEY=replace-with-a-long-random-secret
# IDC_ZIP_MAX_MEMBERS=200
# IDC_ZIP_MAX_MEMBER_MB=100
# IDC_ZIP_MAX_TOTAL_MB=500
# IDC_ZIP_MAX_RATIO=100

# Optional Docker host port:
# IDC_DOCKER_PORT=8080
